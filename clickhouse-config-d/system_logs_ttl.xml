<clickhouse>
  <!--
    Only query_log and part_log are kept (useful when diagnosing Langfuse
    queries and merges). Every other system.*_log is disabled in
    zz-disable-system-logs.xml; do NOT add a <ttl> block for a disabled
    table here: a <table><ttl/></table> element re-enables that log with
    default settings (that is exactly how text_log got switched on in the
    first place), and config.d files merge in alphabetical order.

    Tables whose stock config.xml block sets <engine> (opentelemetry_span_log
    on 25.7) reject a sibling <ttl> with Code 36 BAD_ARGUMENTS at startup.
  -->
  <query_log> <ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_log>
  <part_log>  <ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>
</clickhouse>
